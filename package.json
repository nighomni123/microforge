{
  "name": "micro-product-factory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsx scripts/validate-tools.ts && vite build && tsx scripts/prerender.tsx && tsx scripts/sitemap.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen": "tsx scripts/new-tool.ts",
    "og": "tsx scripts/generate-og.ts",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name=microforge --branch=main"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.0",
    "wrangler": "^4.125.0"
  }
}
