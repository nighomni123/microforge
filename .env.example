# Canonical site URL used for sitemap.xml, robots.txt, canonical + OG tags.
# No trailing slash. Example: https://yourdomain.com
VITE_SITE_URL=

# ---- Ads (Google AdSense) ------------------------------------------------
# Leave empty to ship with zero third-party ad code.
# VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# VITE_ADSENSE_SLOT_INCONTENT=
# VITE_ADSENSE_SLOT_STICKY=
# VITE_ADSENSE_SLOT_SIDEBAR=

# ---- Analytics -----------------------------------------------------------
# Cookieless Umami recommended (https://umami.is). GA4 optional.
# VITE_UMAMI_URL=https://analytics.yourdomain.com/script.js
# VITE_UMAMI_ID=xxxxxxxx
# VITE_GA_ID=G-XXXXXXXXXX
